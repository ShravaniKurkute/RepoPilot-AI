# ==============================================================================
# RepoPilot AI — Root Environment Configuration Template
# Copy this file to .env in backend/ (or root) and fill in your values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# AI & LLM Providers
# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# RAG & Embedding Configuration (Phase 3)
# Set to 'gemini' for real Google Gemini text-embedding-004, or 'mock' for offline development/testing
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64
RAG_TOP_K=10
RAG_SEMANTIC_WEIGHT=0.6
RAG_KEYWORD_WEIGHT=0.4
MAX_CHUNK_LINES=120
CHUNK_OVERLAP_LINES=20

# AI Code Analysis & Bug Detection (Phase 4)
# Set to 'gemini' for production LLM analysis, or 'mock' for offline development/testing
AI_ANALYSIS_PROVIDER=gemini
AI_ANALYSIS_MODEL=gemini-3.8-flash
ANALYSIS_MAX_CONCURRENCY=4
ANALYSIS_MIN_CONFIDENCE=0.4
ANALYSIS_MAX_CONTEXT_CHUNKS=5
GEMINI_REQUEST_TIMEOUT=180.0
ANALYSIS_TIMEOUT=180.0
ANALYSIS_MAX_RETRIES=3

# Database (PostgreSQL + pgvector)
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repopilot_db
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot_secret@localhost:5432/repopilot_db

# Storage & Sandboxing
WORKSPACE_STORAGE_PATH=./workspace_storage
DOCKER_SANDBOX_TIMEOUT_SECONDS=60
DOCKER_MAX_MEMORY_MB=2048
DOCKER_MAX_CPUS=2.0

# Observability & Monitoring
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

